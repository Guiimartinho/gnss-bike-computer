/*
 * nRF54LM20 DK (nrf54lm20dk/nrf54lm20a/cpuapp): development target for the
 * board of our own, which uses the nRF54LM20A. The DK carries the
 * nRF54LM20B, the same part plus an NPU.
 *
 * The DK has none of the myStravaB peripherals. This overlay only gives the
 * application the names it needs (aliases and pin labels) on free pins of
 * the DK expansion header, so the port builds and runs here, and breakout
 * boards can be wired to these pins. The pins follow the nRF54L power
 * domains: serial blocks 20 to 24 on ports P1 and P3, spi00 on P2.
 *
 * Console: uart20 (VCOM0 of the DK), from the board files.
 * Buttons and LED: the DK's sw0, sw1, sw2 and led0.
 *
 *   GPS UART (uart21)     TX P1.04, RX P1.05; reset P1.06, standby P1.07,
 *                         FIX P1.13
 *   Sensor I2C (i2c23)    SDA P1.02, SCL P1.03; IMU INT1 P3.04, RST P3.05
 *   LCD SPI (spi22)       SCK P3.03, MOSI P3.00, CS P3.02 (active high)
 *   SD SPI (spi00)        SCK P2.01, MOSI P2.02, MISO P2.04, CS P2.03
 *   NeoPixel              P3.06
 */

/ {
    chosen {
        zephyr,display = &ls027;
    };

    aliases {
        gps-uart = &uart21;
        lcd-spi = &spi22;
        sdc-spi = &spi00;
        sensor-i2c = &i2c23;
    };

    /* Same polarities as the myStravaB V3 (see nrf52840dk_nrf52840.overlay) */
    gps_ctrl {
        compatible = "gpio-keys";
        gps_reset: gps_reset {
            gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
            label = "GPS Reset";
        };
        gps_stdby: gps_stdby {
            gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
            label = "GPS Standby";
        };
        gps_fix: gps_fix {
            gpios = <&gpio1 13 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
            label = "GPS Fix";
        };
    };

    imu_ctrl {
        compatible = "gpio-keys";
        imu_int1: imu_int1 {
            gpios = <&gpio3 4 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
            label = "IMU INT1";
        };
        imu_reset: imu_reset {
            gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>;
            label = "IMU Reset";
        };
    };

    neopixel_pin {
        compatible = "gpio-keys";
        neo_data: neo_data {
            gpios = <&gpio3 6 GPIO_ACTIVE_HIGH>;
            label = "Neopixel Data";
        };
    };
};

/* Hardware watchdog behind the task watchdog (alias watchdog0 of the DK) */
&wdt31 {
    status = "okay";
};

/* GPS module */
&uart21 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart21_default>;
    pinctrl-1 = <&uart21_sleep>;
    pinctrl-names = "default", "sleep";
};

/* Barometer, IMU and fuel gauge, as on the V3 bus */
&i2c23 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c23_default>;
    pinctrl-1 = <&i2c23_sleep>;
    pinctrl-names = "default", "sleep";

    baro: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
    };

    fxos: fxos8700@1e {
        compatible = "nxp,fxos8700";
        reg = <0x1e>;
        reset-gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>;
        int1-gpios = <&gpio3 4 GPIO_ACTIVE_HIGH>;
    };

    stc3100: stc3100@70 {
        compatible = "st,stc3100";
        reg = <0x70>;
    };
};

/* LCD on the SPI of the expansion header; the LS027 chip select is active high */
&spi22 {
    status = "okay";
    cs-gpios = <&gpio3 2 GPIO_ACTIVE_HIGH>;

    ls027: ls027b7dh01@0 {
        compatible = "sharp,ls0xx";
        reg = <0>;
        spi-max-frequency = <2000000>;
        width = <400>;
        height = <240>;
    };
};

/*
 * microSD on spi00, the fast SPI of port P2. The DK's MX25R64 flash sits on
 * the same bus (CS P2.05, disabled in the board files); its node goes away
 * so that the SD slot can take unit address 0.
 */
/delete-node/ &mx25r64;

&spi00 {
    status = "okay";
    cs-gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        spi-max-frequency = <8000000>;
        mmc {
            compatible = "zephyr,sdmmc-disk";
            status = "okay";
            disk-name = "SD";
        };
    };
};

&pinctrl {
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 5)>;
            bias-pull-up;
        };
    };

    uart21_sleep: uart21_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>,
                    <NRF_PSEL(UART_RX, 1, 5)>;
            low-power-enable;
        };
    };

    i2c23_default: i2c23_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;
        };
    };

    i2c23_sleep: i2c23_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;
            low-power-enable;
        };
    };
};
