/*
 * nRF54LM20 DK (nrf54lm20dk/nrf54lm20a/cpuapp): development target of the
 * new board, which uses the nRF54LM20A (the DK carries the nRF54LM20B, the
 * same part plus an NPU).
 *
 * The DK has none of the peripherals of the new board. This overlay puts
 * them on free pins of the DK, with the pins of docs/14-hardware-placa-nova.md
 * (Alocação de pinos, "Pino no DK"), so evaluation boards can be wired to
 * them. The serial blocks follow the nRF54L power domains: 20 to 24 on
 * ports P1 and P3, spi00 on P2.
 *
 * Console: uart20 (VCOM0 of the DK), from the board files.
 *
 *   GNSS UART (uart21)    TX P1.04, RX P1.05
 *   Sensor I2C (i2c23)    SDA P1.02, SCL P1.03; IMU INT1 P3.04
 *   SD SPI (spi00)        SCK P2.01, MOSI P2.02, MISO P2.04, CS P2.03
 *
 * The services find the devices by these aliases: gnss, baro0, imu0, mag0,
 * light0 (docs/16, Serviços). A device that does not answer is left out.
 */

#include <zephyr/dt-bindings/sensor/bmp581.h>

/ {
    aliases {
        gnss = &gnss;
        baro0 = &bmp585;
        imu0 = &bmi270;
        mag0 = &mmc5633;
        light0 = &opt3001;
    };
};

/* Hardware watchdog behind the task watchdog (alias watchdog0 of the DK) */
&wdt31 {
    status = "okay";
};

/*
 * GNSS: u-blox MAX-M10N-10B. Until its UBX driver (u-blox,m10) lands, the
 * NMEA the module sends at power-up goes through gnss-nmea-generic. The rate
 * below is where the receiver starts; the UBX driver sets it with
 * CFG-UART1-BAUDRATE.
 */
&uart21 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart21_default>;
    pinctrl-1 = <&uart21_sleep>;
    pinctrl-names = "default", "sleep";

    gnss: gnss-nmea-generic {
        compatible = "gnss-nmea-generic";
    };
};

/*
 * Sensors of the new board (docs/14, Barramentos e endereços): no address
 * collides, and nothing scans the bus (0x7E puts the MMC5633NJL in I3C).
 */
&i2c23 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c23_default>;
    pinctrl-1 = <&i2c23_sleep>;
    pinctrl-names = "default", "sleep";

    /* Bosch BMP585 (the BMP581 driver accepts its chip ID); SDO high: 0x47 */
    bmp585: bmp585@47 {
        compatible = "bosch,bmp581";
        reg = <0x47>;
        power-mode = <BMP581_DT_MODE_NORMAL>;
        odr = <BMP581_DT_ODR_10_HZ>;
        press-osr = <BMP581_DT_OVERSAMPLING_8X>;
        temp-osr = <BMP581_DT_OVERSAMPLING_2X>;
    };

    /* Bosch BMI270, SDO low: 0x68 */
    bmi270: bmi270@68 {
        compatible = "bosch,bmi270";
        reg = <0x68>;
        irq-gpios = <&gpio3 4 GPIO_ACTIVE_HIGH>;
    };

    /* Memsic MMC5633NJL, fixed address; a measurement per fetch */
    mmc5633: mmc5633@30 {
        compatible = "memsic,mmc56x3";
        reg = <0x30>;
        magn-odr = <0>;
    };

    /* TI OPT3001, ADDR low: 0x44 */
    opt3001: opt3001@44 {
        compatible = "ti,opt3001";
        reg = <0x44>;
    };
};

/*
 * microSD on spi00, the fast SPI of port P2. The DK's MX25R64 flash sits on
 * the same bus (CS P2.05, disabled in the board files); its node goes away
 * so that the SD slot can take unit address 0.
 */
/delete-node/ &mx25r64;

&spi00 {
    status = "okay";
    cs-gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        spi-max-frequency = <8000000>;
        mmc {
            compatible = "zephyr,sdmmc-disk";
            status = "okay";
            disk-name = "SD";
        };
    };
};

&pinctrl {
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 5)>;
            bias-pull-up;
        };
    };

    uart21_sleep: uart21_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>,
                    <NRF_PSEL(UART_RX, 1, 5)>;
            low-power-enable;
        };
    };

    i2c23_default: i2c23_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;
        };
    };

    i2c23_sleep: i2c23_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;
            low-power-enable;
        };
    };
};
