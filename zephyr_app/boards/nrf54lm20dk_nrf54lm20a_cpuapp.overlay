/*
 * nRF54LM20 DK (nrf54lm20dk/nrf54lm20a/cpuapp): development target of the
 * new board, which uses the nRF54LM20A (the DK carries the nRF54LM20B, the
 * same part plus an NPU).
 *
 * The DK has none of the peripherals of the new board. This overlay puts
 * them on free pins of the DK, with the pins of docs/14-hardware-placa-nova.md
 * (Alocação de pinos, "Pino no DK"), so evaluation boards can be wired to
 * them. The serial blocks follow the nRF54L power domains: 20 to 24 on
 * ports P1 and P3, spi00 on P2.
 *
 * Console: uart20 (VCOM0 of the DK), from the board files.
 *
 *   GNSS UART (uart21)    TX P1.04, RX P1.05
 *   Sensor I2C (i2c23)    SDA P1.02, SCL P1.03; IMU INT1 P3.04
 *   SD SPI (spi00)        SCK P2.01, MOSI P2.02, MISO P2.04, CS P2.03
 *   Display SPI (spi22)   SCK P3.03, MOSI P3.00, CS P3.02; DISP P3.05,
 *                         EXTCOMIN P3.06
 *   Keys                  buttons 0, 1 and 2 of the DK (left, centre, right)
 *   Light                 LED 1 of the DK (pwm20) stands for the display light
 *
 * The services find the devices by these aliases: gnss, baro0, imu0, mag0,
 * light0 and backlight (docs/16, Serviços), the display by the chosen node
 * zephyr,display and the keys by the node label longpress. A device that
 * does not answer is left out.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/sensor/bmp581.h>

/ {
    chosen {
        zephyr,display = &display;
    };

    aliases {
        gnss = &gnss;
        baro0 = &bmp585;
        imu0 = &bmi270;
        mag0 = &mmc5633;
        light0 = &opt3001;
        backlight = &pwm_led1;
    };

    /*
     * The three keys: short on release before 1 s, long after 1 s held
     * (docs/18, Botões); the interface reads the codes of this node only.
     */
    longpress: longpress {
        compatible = "zephyr,input-longpress";
        input = <&dk_buttons>;
        input-codes = <INPUT_KEY_0>, <INPUT_KEY_1>, <INPUT_KEY_2>;
        short-codes = <INPUT_KEY_LEFT>, <INPUT_KEY_ENTER>, <INPUT_KEY_RIGHT>;
        long-codes = <INPUT_KEY_HOME>, <INPUT_KEY_MENU>, <INPUT_KEY_END>;
        long-delay-ms = <1000>;
    };

    /* The buttons of the board files, with a label for the node above */
    dk_buttons: buttons {
    };
};

/* Hardware watchdog behind the task watchdog (alias watchdog0 of the DK) */
&wdt31 {
    status = "okay";
};

/*
 * GNSS: u-blox MAX-M10N-10B. Until its UBX driver (u-blox,m10) lands, the
 * NMEA the module sends at power-up goes through gnss-nmea-generic. The rate
 * below is where the receiver starts; the UBX driver sets it with
 * CFG-UART1-BAUDRATE.
 */
&uart21 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart21_default>;
    pinctrl-1 = <&uart21_sleep>;
    pinctrl-names = "default", "sleep";

    gnss: gnss-nmea-generic {
        compatible = "gnss-nmea-generic";
    };
};

/*
 * Sensors of the new board (docs/14, Barramentos e endereços): no address
 * collides, and nothing scans the bus (0x7E puts the MMC5633NJL in I3C).
 */
&i2c23 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c23_default>;
    pinctrl-1 = <&i2c23_sleep>;
    pinctrl-names = "default", "sleep";

    /* Bosch BMP585 (the BMP581 driver accepts its chip ID); SDO high: 0x47 */
    bmp585: bmp585@47 {
        compatible = "bosch,bmp581";
        reg = <0x47>;
        power-mode = <BMP581_DT_MODE_NORMAL>;
        odr = <BMP581_DT_ODR_10_HZ>;
        press-osr = <BMP581_DT_OVERSAMPLING_8X>;
        temp-osr = <BMP581_DT_OVERSAMPLING_2X>;
    };

    /* Bosch BMI270, SDO low: 0x68 */
    bmi270: bmi270@68 {
        compatible = "bosch,bmi270";
        reg = <0x68>;
        irq-gpios = <&gpio3 4 GPIO_ACTIVE_HIGH>;
    };

    /* Memsic MMC5633NJL, fixed address; a measurement per fetch */
    mmc5633: mmc5633@30 {
        compatible = "memsic,mmc56x3";
        reg = <0x30>;
        magn-odr = <0>;
    };

    /* TI OPT3001, ADDR low: 0x44 */
    opt3001: opt3001@44 {
        compatible = "ti,opt3001";
        reg = <0x44>;
    };
};

/*
 * Display: JDI LPM027M128B (docs/18), 400 x 240 in 8 colours, drawn in
 * portrait by the driver of modules/gnss_drivers. EXTMODE high on the panel
 * side: the COM inverts on the rising edges of EXTCOMIN. The panel runs from
 * 3.0 V and wants its inputs at that level (high above VDD - 0.1 V, datasheet
 * 3.1): the DK I/O must be at 3.0 V, or the signals need level shifting.
 * Timing (datasheet 4.2): SCLK 1 MHz typical and 2 MHz at most, chip select
 * active high, 6 us before the first clock and 2 us after the last.
 * The Sharp LS027B7DH01 of the backup plan takes the same node with
 * compatible "sharp,ls027b7dh01", 3 us and 1 us around the chip select and
 * power-gpios on the enable of its 5 V regulator.
 */
&spi22 {
    status = "okay";
    cs-gpios = <&gpio3 2 GPIO_ACTIVE_HIGH>;
    pinctrl-0 = <&spi22_display_default>;
    pinctrl-1 = <&spi22_display_sleep>;
    pinctrl-names = "default", "sleep";

    display: display@0 {
        compatible = "jdi,lpm027m128b";
        reg = <0>;
        spi-max-frequency = <2000000>;
        spi-cs-setup-delay-ns = <6000>;
        spi-cs-hold-delay-ns = <2000>;
        width = <400>;
        height = <240>;
        disp-gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>;
        extcomin-gpios = <&gpio3 6 GPIO_ACTIVE_HIGH>;
    };
};

/*
 * microSD on spi00, the fast SPI of port P2. The DK's MX25R64 flash sits on
 * the same bus (CS P2.05, disabled in the board files); its node goes away
 * so that the SD slot can take unit address 0.
 */
/delete-node/ &mx25r64;

&spi00 {
    status = "okay";
    cs-gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        spi-max-frequency = <8000000>;
        mmc {
            compatible = "zephyr,sdmmc-disk";
            status = "okay";
            disk-name = "SD";
        };
    };
};

&pinctrl {
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 5)>;
            bias-pull-up;
        };
    };

    uart21_sleep: uart21_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>,
                    <NRF_PSEL(UART_RX, 1, 5)>;
            low-power-enable;
        };
    };

    i2c23_default: i2c23_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;
        };
    };

    i2c23_sleep: i2c23_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;
            low-power-enable;
        };
    };

    /* The display only listens: no MISO, P3.01 stays free */
    spi22_display_default: spi22_display_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 3, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 3, 0)>;
        };
    };

    spi22_display_sleep: spi22_display_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 3, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 3, 0)>;
            low-power-enable;
        };
    };
};
