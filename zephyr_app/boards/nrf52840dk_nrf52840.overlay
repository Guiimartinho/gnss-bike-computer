/*
 * nRF52840 DK with the pins of the myStravaB V3 (custom_board_v3.h of the
 * legacy). The V3 exists as a schematic only; this target keeps the port
 * building on the nRF52840 and lets the V3 parts be wired to a DK.
 *
 * Pin Mapping (from custom_board_v3.h):
 * - I2C: SDA=P1.00, SCL=P1.01
 * - UART (GPS): TX=P0.05, RX=P0.07
 * - SPI LCD: MOSI=P0.16, SCK=P0.15, CS=P0.17
 * - SPI SDC: MOSI=P0.25, SCK=P0.27, MISO=P0.28, CS=P0.26
 * - Buttons: B1=P0.14, B2=P0.13, B3=P0.11
 * - LED: P1.04
 * - GPS: RST=P0.03, STDBY=P1.15, FIX=P1.14
 * - IMU: INT1=P1.02, RST=P1.03
 * - Neopixel: P1.13
 *
 * The services find the devices by aliases (docs/16, Serviços): the GPS of
 * the V3 is an NMEA module (gnss-nmea-generic), the BME280 is the barometer
 * and the FXOS8700 gives the accelerometer and the magnetometer. The STC3100
 * fuel gauge has no Zephyr driver, so the V3 target has no battery reading.
 * The LS027 is the chosen display and the node label longpress gives the
 * keys to the interface (docs/18).
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zephyr,display = &ls027;
    };

    aliases {
        led0 = &led0;
        sw0 = &button0;
        sw1 = &button1;
        sw2 = &button2;
        gnss = &gnss;
        baro0 = &baro;
        imu0 = &fxos;
        mag0 = &fxos;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
            label = "Status LED";
        };
    };

    /*
     * The three keys: short on release before 1 s, long after 1 s held
     * (docs/18, Botões); the interface reads the codes of this node only.
     */
    longpress: longpress {
        compatible = "zephyr,input-longpress";
        input = <&v3_buttons>;
        input-codes = <INPUT_KEY_LEFT>, <INPUT_KEY_ENTER>, <INPUT_KEY_RIGHT>;
        short-codes = <INPUT_KEY_LEFT>, <INPUT_KEY_ENTER>, <INPUT_KEY_RIGHT>;
        long-codes = <INPUT_KEY_HOME>, <INPUT_KEY_MENU>, <INPUT_KEY_END>;
        long-delay-ms = <1000>;
    };

    v3_buttons: buttons {
        compatible = "gpio-keys";
        button0: button_0 {
            gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Button Left";
            zephyr,code = <INPUT_KEY_LEFT>;
        };
        button1: button_1 {
            gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Button Center";
            zephyr,code = <INPUT_KEY_ENTER>;
        };
        button2: button_2 {
            gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Button Right";
            zephyr,code = <INPUT_KEY_RIGHT>;
        };
    };
};

/* Disable I2C1 (conflicts with SPI1) */
&i2c1 {
    status = "disabled";
};

/*
 * nRF52840-DK devices that sit on pins of the myStravaB board. Their drivers
 * would claim the pins at boot, before the application:
 * - qspi (MX25R64): CSN on P0.17, the LCD chip select;
 * - spi3 (arduino_spi): P1.13/P1.14/P1.15, the NeoPixel, GPS FIX and GPS STDBY;
 * - pwm0 (pwm_led0): P0.13, the centre button.
 */
&qspi {
    status = "disabled";
};

/* The child keeps its own status: without this the qspi-nor driver still
 * builds and applies the QSPI pinctrl (CSN on P0.17) at boot. */
&mx25r64 {
    status = "disabled";
};

&spi3 {
    status = "disabled";
};

&pwm0 {
    status = "disabled";
};

/* I2C0 - Sensors (Barometer, IMU, Fuel Gauge) */
&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    /* BMP280/BME280 Barometer */
    baro: bmp280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
        label = "BARO";
    };

    /* FXOS8700 Accelerometer/Magnetometer. RST has no pull resistor on the
     * board and is active high (legacy/source/sensors/fxos.cpp:350-353): the
     * driver drives it (reset pulse, then low) before main(). */
    fxos: fxos8700@1e {
        compatible = "nxp,fxos8700";
        reg = <0x1e>;
        label = "FXOS";
        reset-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
        int1-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
    };
};

/* UART1 - GPS Module (Antenova M10578-A3, NMEA at 9600 as the legacy starts it) */
&uart1 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";

    gnss: gnss-nmea-generic {
        compatible = "gnss-nmea-generic";
    };
};

/*
 * SPI1 - LCD LS027B7DH01, 5 V from the REG710 (U$16 of the V3). On the V3
 * EXTMODE and EXTCOMIN go to GND through 10k (R13, R16) and DISP to VCC
 * through 10k and 0.1 uF (R17, C43): no pins, and the driver of
 * modules/gnss_drivers inverts the VCOM by the serial bit, as the legacy.
 * Timing (LS027B7DH01 6-3): 2 MHz at most, chip select active high, 3 us
 * before the first clock and 1 us after the last (2 us here, margin for the
 * 220 us the chip select stays high in a one-line update).
 */
&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;

    ls027: display@0 {
        compatible = "sharp,ls027b7dh01";
        reg = <0>;
        spi-max-frequency = <2000000>;
        spi-cs-setup-delay-ns = <3000>;
        spi-cs-hold-delay-ns = <2000>;
        width = <400>;
        height = <240>;
    };
};

/* SPI2 - SD Card */
&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        spi-max-frequency = <8000000>;
        mmc {
            compatible = "zephyr,sdmmc-disk";
            status = "okay";
            disk-name = "SD";
        };
    };
};

/* Pin Control */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 0)>,
                    <NRF_PSEL(TWIM_SCL, 1, 1)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 0)>,
                    <NRF_PSEL(TWIM_SCL, 1, 1)>;
            low-power-enable;
        };
    };

    /*
     * uart0 is the console of the DK (TX P0.06, RX P0.08). The DK also routes
     * its unused RTS/CTS to P0.05/P0.07, the GPS UART pins of this board:
     * keep only TX and RX.
     */
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>;
            bias-pull-up;
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>;
            low-power-enable;
        };
        group2 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>;
            low-power-enable;
            bias-pull-up;
        };
    };

    uart1_default: uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 5)>;
            /* the DK's uart1 group1 is an RX group with a pull-up */
            /delete-property/ bias-pull-up;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 7)>;
            bias-pull-up;
        };
    };

    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 5)>,
                    <NRF_PSEL(UART_RX, 0, 7)>;
            low-power-enable;
        };
    };

    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>;
            low-power-enable;
        };
    };

    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 27)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 25)>,
                    <NRF_PSEL(SPIM_MISO, 0, 28)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 27)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 25)>,
                    <NRF_PSEL(SPIM_MISO, 0, 28)>;
            low-power-enable;
        };
    };
};
